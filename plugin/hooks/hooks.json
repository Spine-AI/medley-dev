{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"" },
          { "type": "command", "timeout": 5, "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session-catchup.py\"" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "timeout": 5, "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session-catchup.py\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Task|Bash|apply_patch|spawn_agent",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/edit-conflict-gate.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__mission_(start|resume|status|wait)",
        "hooks": [
          { "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session-mission-binder.py\"" }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "timeout": 5, "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session-end-marker.py\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "timeout": 10, "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/mission-watch-gate.py\"" }
        ]
      }
    ]
  }
}
